{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>gabe565/renovate-config"
  ],
  "automerge": true,
  "regexManagers": [
    {
      "fileMatch": ["^\\.github/workflows/"],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "\\s+DS5DONGLECONFIGWEB_REPO: (?<depName>.+)",
        "\\s+DS5DONGLECONFIGWEB_BRANCH: (?<currentValue>.+)\\n\\s+DS5DONGLECONFIGWEB_REF: (?<currentDigest>.+)"
      ],
      "packageNameTemplate": "https://github.com/{{depName}}",
      "datasourceTemplate": "git-refs"
    }
  ]
}
